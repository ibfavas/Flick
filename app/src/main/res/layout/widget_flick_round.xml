<?xml version="1.0" encoding="utf-8"?>
<!-- Round widget (1x1): the transparent Flick logo on a pitch-black disc.
     The whole widget is the button: tap it to open the drawing pad. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_round_bg">

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/flick_logo_transparent" />

</FrameLayout>
