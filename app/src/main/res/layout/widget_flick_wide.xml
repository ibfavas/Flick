<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_wide_bg">
    <ImageView
        android:id="@+id/widget_edge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_edge" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="0.8"
            android:layout_height="28dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wordmark_letters" />
            <ImageView
                android:id="@+id/wordmark_dot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wordmark_dot" />
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_divider"
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="5dp"
            android:alpha="0.5"
            android:src="@android:color/white" />

        <LinearLayout
            android:id="@+id/widget_draw"
            android:layout_width="0dp"
            android:layout_weight="1.25"
            android:layout_height="match_parent"
            android:gravity="center"
            android:contentDescription="@string/open_pad"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_glyph"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/widget_gesture" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:maxLines="2"
                android:text="@string/widget_draw_label"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_expand"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_open_app">
            <ImageView
                android:id="@+id/widget_expand_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_button_bg"
                android:padding="5dp"
                android:src="@drawable/widget_corners" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
