<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform Material theme: Compose Material3 ships no XML themes, so
         the old Theme.Material3.DayNight.NoActionBar parent did not exist in
         any dependency and broke resource linking. All UI is drawn by
         Compose's MaterialTheme (see ui/Theme.kt); this theme only sets the
         window chrome. -->
    <style name="Theme.Flick" parent="android:Theme.Material.NoActionBar" />

    <!-- Transparent theme for the gesture pad activity. -->
    <style name="Theme.Flick.Draw" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/FlickDrawAnimation</item>
    </style>

    <!-- The pad fades in and out instead of sliding, so the screen
         underneath stays put while the overlay appears and disappears. -->
    <style name="FlickDrawAnimation" parent="@android:style/Animation.Activity">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
