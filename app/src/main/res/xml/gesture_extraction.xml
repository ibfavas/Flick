<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="flick.db" />
        <include domain="database" path="flick.db-wal" />
        <include domain="database" path="flick.db-journal" />
        <include domain="sharedpref" path="gesture_backup.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="flick.db" />
        <include domain="database" path="flick.db-wal" />
        <include domain="database" path="flick.db-journal" />
        <include domain="sharedpref" path="gesture_backup.xml" />
    </device-transfer>
</data-extraction-rules>
