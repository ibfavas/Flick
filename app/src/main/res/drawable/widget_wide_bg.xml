<?xml version="1.0" encoding="utf-8"?>
<!-- Wide widget background: a pitch-black rounded rectangle with a thin
     neutral outline, matching the AMOLED theme. The wordmark sits on top. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF000000" />
    <stroke android:width="1dp" android:color="#FF2E2E2E" />
    <corners android:radius="20dp" />
</shape>
