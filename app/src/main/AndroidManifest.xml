<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for the flashlight actions. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Needed for the "call a contact" action: read the contact, then place the call. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Needed for the vibration feedback when a gesture runs. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Lets the app picker list launchable apps without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".FlickApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flick">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The drawing pad must never appear in recents (v1.2.1):
             excludeFromRecents keeps the pad out of the recents list
             while the pad itself still works normally. NOT noHistory:
             the pad must survive the user switching apps mid-draw and
             coming back. The launch intents below also carry
             FLAG_ACTIVITY_EXCLUDE_FROM_RECENTS as belt and braces. -->
        <activity
            android:name=".DrawActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Flick.Draw" />

        <!-- Diagnostic crash screen (v1.0.2): shows the captured stack
             trace in plain Views when the app crashes. Not exported. -->
        <activity
            android:name=".CrashActivity"
            android:exported="false" />

        <!-- Invisible widget (2x1): a fully transparent tap area that
             opens the drawing pad. Labelled "Flick (Invisible)" in the
             picker so it can be found even though nothing shows. -->
        <receiver
            android:name=".widget.FlickWidgetProvider"
            android:exported="true"
            android:label="@string/widget_invisible_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/flick_widget_info" />
        </receiver>

        <!-- Round widget (1x1): the Flick logo on a black disc. -->
        <receiver
            android:name=".widget.FlickRoundWidgetProvider"
            android:exported="true"
            android:label="@string/widget_round_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/flick_round_widget_info" />
        </receiver>

        <!-- Wide widget (3x1): the flick wordmark on black. -->
        <receiver
            android:name=".widget.FlickWideWidgetProvider"
            android:exported="true"
            android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/flick_wide_widget_info" />
        </receiver>

        <!-- Accessibility service: lock screen and screenshot only.
             Optional; Flick works without it. -->
        <service
            android:name=".actions.FlickAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/flick_accessibility_config" />
        </service>

        <service
            android:name=".tile.FlickTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
